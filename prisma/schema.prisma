generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  companyId      String?
  isActive       Boolean       @default(true)
  roleTemplateId String?
  auditLogs      AuditLog[]
  comments       Comment[]
  ordersCreated  Order[]       @relation("OrderCreator")
  orders         Order[]       @relation("CustomerOrders")
  company        Company?      @relation(fields: [companyId], references: [id])
  RoleTemplate   RoleTemplate? @relation(fields: [roleTemplateId], references: [id])
}

model ProductGroup {
  id               String      @id @default(cuid())
  displayName      String
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  skus             Product[]
  sourcePromotions Promotion[] @relation("SourceGroupPromotions")
}

model Product {
  id               String         @id @default(cuid())
  sku              String         @unique
  name             String
  imageUrl         String
  basePrice        Float
  stockPacks       Int            @default(5000)
  isActive         Boolean        @default(true)
  isFavorite       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  groupId          String?
  priority         Int            @default(0)
  orderItems       OrderItem[]
  skuAllocations   OrderItemSku[]
  group            ProductGroup?  @relation(fields: [groupId], references: [id])
  bonusPromotions  Promotion[]    @relation("BonusProductPromotions")
  sourcePromotions Promotion[]    @relation("SourceProductPromotions")
  tags             Tag[]          @relation("ProductTags")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  products  Product[] @relation("ProductTags")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  status          String
  totalPacks      Int
  totalBlocks     Int
  totalCases      Float
  totalPrice      Float
  fileUrl         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isHistorical    Boolean     @default(false)
  source          OrderSource @default(MANUAL)
  fileId          String?
  companyId       String?
  createdByUserId String?
  fileName        String?
  comments        Comment[]
  company         Company?    @relation(fields: [companyId], references: [id])
  createdBy       User?       @relation("OrderCreator", fields: [createdByUserId], references: [id])
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  productId           String
  quantityPacks       Int            @default(0)
  quantityBlocks      Int            @default(0)
  quantityCases       Float          @default(0)
  price               Float
  createdAt           DateTime       @default(now())
  itemTotalPrice      Float?
  productNameSnapshot String?
  skuSnapshot         String?
  bonusQuantityPacks  Int            @default(0)
  effectivePrice      Float?
  isBonus             Boolean        @default(false)
  promotionNote       String?
  baseQuantityBlocks  Int            @default(0)
  baseQuantityCases   Float          @default(0)
  baseQuantityPacks   Int            @default(0)
  bonusQuantityBlocks Int            @default(0)
  bonusQuantityCases  Float          @default(0)
  promotionDiscount   Float?
  promotionId         String?
  totalQuantityBlocks Int            @default(0)
  totalQuantityCases  Float          @default(0)
  totalQuantityPacks  Int            @default(0)
  groupDisplayName    String?
  groupId             String?
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id])
  skuAllocations      OrderItemSku[]
}

model OrderItemSku {
  id          String    @id @default(cuid())
  orderItemId String
  productId   String
  packs       Int
  sku         String
  name        String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
}

model Template {
  id         String   @id @default(cuid())
  name       String
  fileId     String?
  isActive   Boolean  @default(false)
  uploadDate DateTime @default(now())
  version    String   @default("1.0.0")
  isLocal    Boolean  @default(true)
  filePath   String?
  outputMode String   @default("COMMERCIAL")
}

model PlaceholderMapping {
  id          String   @id @default(cuid())
  placeholder String   @unique
  systemField String
  description String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String
  timestamp DateTime @default(now())
  ipAddress String?
  newValue  String?
  oldValue  String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  userName  String
  text      String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Company {
  id                 String      @id @default(cuid())
  name               String
  code               String      @unique
  inn                String?
  purchasePlanCases  Float       @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  monthlyTargetCases Float?      @default(0)
  orders             Order[]
  users              User[]
  promotions         Promotion[] @relation("CompanyPromotions")
}

model Promotion {
  id                   String        @id @default(cuid())
  name                 String
  isActive             Boolean       @default(true)
  startDate            DateTime?
  endDate              DateTime?
  applyToAllCompanies  Boolean       @default(true)
  bonusMode            BonusMode     @default(SAME_SKU)
  minimumBlocks        Int           @default(50)
  bonusBlocks          Int           @default(5)
  sourceProductId      String?
  bonusProductId       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  allocatedAmount      Float?
  consumedAmount       Float?        @default(0.0)
  discountPercent      Float?
  maxOrderUsagePercent Float?        @default(10.0)
  remainingAmount      Float?
  sourceGroupId        String?
  type                 PromotionType @default(SKU_BONUS)
  bonusProduct         Product?      @relation("BonusProductPromotions", fields: [bonusProductId], references: [id])
  sourceGroup          ProductGroup? @relation("SourceGroupPromotions", fields: [sourceGroupId], references: [id])
  sourceProduct        Product?      @relation("SourceProductPromotions", fields: [sourceProductId], references: [id], onDelete: Cascade)
  companies            Company[]     @relation("CompanyPromotions")
}

model RoleTemplate {
  id               String   @id
  name             String   @unique
  description      String?
  isSystem         Boolean  @default(false)
  defaultDashboard String   @default("/admin")
  permissions      String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  User             User[]
}

enum OrderSource {
  MANUAL
  IMPORT
  API
}

enum PromotionType {
  SKU_BONUS
  ORDER_PERCENTAGE
  ORDER_FIXED_AMOUNT
}

enum BonusMode {
  SAME_SKU
  ANOTHER_SKU
}
